{
  "ConnectionStrings": {
    "ClockOutAPIContext": "SET_WITH_ENV_ConnectionStrings__ClockOutAPIContext"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://clockout-tracker.vercel.app"
    ]
  },
  "Jwt": {
    "Key": "SET_WITH_ENV_Jwt__Key",
    "Issuer": "clockout-api",
    "Audience": "clockout-client",
    "ExpiryMinutes": 120
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
