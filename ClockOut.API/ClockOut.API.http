@host = http://localhost:5278
@contentType = application/json

### Health check / root test
GET {{host}}/
Accept: application/json

### ------------------------------------------------------------
### AUTH
### ------------------------------------------------------------

### Register (returns access token + user)
POST {{host}}/api/auth/register
Content-Type: {{contentType}}

{
  "email": "student1@example.com",
  "password": "StrongPass123!",
  "firstName": "Juan",
  "lastName": "Dela Cruz"
}

###

### Login
# Captures JWT for later requests.
> {%
client.global.set("jwt", response.body.accessToken);
%}
POST {{host}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "student1@example.com",
  "password": "StrongPass123!"
}

### ------------------------------------------------------------
### ME (authenticated profile)
### ------------------------------------------------------------

### Get my profile
GET {{host}}/api/me
Authorization: Bearer {{jwt}}
Accept: application/json

###

### Update my profile
PUT {{host}}/api/me
Authorization: Bearer {{jwt}}
Content-Type: {{contentType}}

{
  "firstName": "Juan",
  "lastName": "Dela Cruz",
  "requiredHours": 300
}

### ------------------------------------------------------------
### LOGS (authenticated, user-scoped)
### ------------------------------------------------------------

### Get my logs
GET {{host}}/api/logs
Authorization: Bearer {{jwt}}
Accept: application/json

###

### Create a log entry
POST {{host}}/api/logs
Authorization: Bearer {{jwt}}
Content-Type: {{contentType}}

{
  "date": "2026-04-03",
  "hoursRendered": 8,
  "taskDescription": "Built API auth and DTO integrations",
  "supervisorName": "Mr. Santos"
}

###

### Get one of my log entries by id
@logEntryId = 1
GET {{host}}/api/logs/{{logEntryId}}
Authorization: Bearer {{jwt}}
Accept: application/json

###

### Update one of my log entries by id
PUT {{host}}/api/logs/{{logEntryId}}
Authorization: Bearer {{jwt}}
Content-Type: {{contentType}}

{
  "date": "2026-04-03",
  "hoursRendered": 7.5,
  "taskDescription": "Updated OJT logs and docs",
  "supervisorName": "Mr. Santos"
}

###

### Get logs summary
GET {{host}}/api/logs/summary
Authorization: Bearer {{jwt}}
Accept: application/json

###

### Delete one of my log entries by id
DELETE {{host}}/api/logs/{{logEntryId}}
Authorization: Bearer {{jwt}}
Accept: application/json
